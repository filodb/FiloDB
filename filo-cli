#!/usr/bin/env bash

# set -x
SCALA_VERSION="2.13"
CLI_DIR=`pwd`"/cli/target/scala-$SCALA_VERSION"
# The version comes from the git branch (see project/FiloVersion.scala), so pick the newest CLI jar.
function find_cli_file {
    ls -t "$CLI_DIR"/filo-cli-* 2>/dev/null | head -1
}
CLI_FILE=$(find_cli_file)

function isJava8(){
    if [[ "$JAVA" ]]; then
        version=$("$JAVA" -version 2>&1 | awk -F '"' '/version/ {print $2}')
        if [[ "$version" < "1.8" ]]; then
            echo "FiloDB requires Java JDK 1.8 and the current version is $version. Please upgrade to continue."
            exit
        fi
    fi
}

function check_java {
    JAVA=$(type -p java)
    if [ -z "$JAVA" ]; then
        echo "Failed to find Java in PATH. Please install Java JDK 1.8"
        exit
    fi
}

function check_sbt {
    if [ -z $1 ]; then
        echo "Failed to find SBT in PATH. Please install SBT"
        exit
    fi
}

isJava8
check_java

SBT=$(type -p sbt)

check_sbt $SBT

if [ ! -f "$CLI_FILE" ];then
    # run assembly if file doesn't exist
    $SBT cli/assembly
    CLI_FILE=$(find_cli_file)
    # initialize DB on first run
    $CLI_FILE --command init
fi

$CLI_FILE "$@"
